[Unit]
Wants=voc-app.service
After=voc-app.service

[Container]
CgroupsMode=enabled
Image=localhost/g2r2-voc-nginx:1
Pull=never
ContainerName=voc-nginx
Network=voc.network
IP=10.89.82.9
PublishPort=8989:443
Volume=/etc/g2r2-voc/tls:/etc/voc-tls:ro,Z

[Service]
Delegate=yes
Restart=always

[Install]
WantedBy=multi-user.target
