[Unit]
Requires=voc-db.service
After=voc-db.service

[Container]
CgroupsMode=enabled
Image=localhost/g2r2-voc:1
Pull=never
ContainerName=voc-app
Network=voc.network
EnvironmentFile=/etc/g2r2-voc/db.env
EnvironmentFile=/etc/g2r2-voc/app.env
Volume=voc-media.volume:/media/uploads:U

[Service]
Delegate=yes
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
